{
  "name": "criativos-de-imagem",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Editor de criativos estáticos para anúncios da Meta, nos três formatos fixos (4:5, 1:1, 9:16).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:visual:update": "UPDATE_REFS=1 vitest run --config vitest.visual.config.ts"
  },
  "dependencies": {
