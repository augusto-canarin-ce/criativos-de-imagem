# Cabeçalhos do Cloudflare Pages (2026-08-17).
#
# O app é 100% estático e não fala com servidor nenhum — estes cabeçalhos são
# o que garante isso do lado do navegador também.

/*
  # Quem pode embutir o app num iframe (2026-08-17). `frame-ancestors` substitui
  # o antigo X-Frame-Options: DENY, que não tem lista de permitidos — a lista é
  # o que deixa a plataforma do usuário embutir e continua barrando o resto da
  # internet. `self` mantém o próprio app podendo se embutir.
  Content-Security-Policy: frame-ancestors 'self' https://extremo.app https://*.extremo.app
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Sem câmera, microfone ou localização: o app não usa nada disso.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/assets/*
  # Nome com hash do conteúdo: pode cachear para sempre.
  Cache-Control: public, max-age=31536000, immutable

/templates/*
  # Modelos de fábrica mudam com o deploy; revalida sempre.
  Cache-Control: public, max-age=0, must-revalidate
