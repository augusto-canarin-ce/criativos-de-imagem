# Cabeçalhos do Cloudflare Pages (2026-08-17).
#
# O app é 100% estático e não fala com servidor nenhum — estes cabeçalhos são
# o que garante isso do lado do navegador também.

/*
  # Embed em iframe LIBERADO para qualquer site (2026-08-17).
  #
  # Começou como X-Frame-Options: DENY, virou uma lista com os domínios da
  # plataforma do usuário, e terminou sem restrição: o validador da plataforma
  # reprova qualquer `frame-ancestors`, sem checar se ela própria está na lista.
  #
  # O risco aceito é clickjacking — outro site embutir o app e se passar por ele.
  # Aqui isso é pequeno: não há login, conta, pagamento nem envio de dado para
  # servidor. Não existe o que roubar com um clique enganado; o pior caso é
  # atribuição indevida, e o código é MIT de qualquer forma.
  #
  # Para voltar a restringir, basta reintroduzir a diretiva:
  #   Content-Security-Policy: frame-ancestors 'self' https://extremo.app https://*.extremo.app
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Sem câmera, microfone ou localização: o app não usa nada disso.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

/assets/*
  # Nome com hash do conteúdo: pode cachear para sempre.
  Cache-Control: public, max-age=31536000, immutable

/templates/*
  # Modelos de fábrica mudam com o deploy; revalida sempre.
  Cache-Control: public, max-age=0, must-revalidate
